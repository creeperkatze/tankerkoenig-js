{
    "name": "tankerkoenig-js",
    "version": "1.0.18",
    "description": "JavaScript API client for the Tankerkönig gas prices API",
    "homepage": "https://tankerkoenig-js.creeperkatze.dev",
    "type": "module",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsc",
        "website:api": "typedoc --options typedoc.json",
        "website:dev": "concurrently -n typedoc,vitepress -c yellow,cyan \"typedoc --options typedoc.json --watch\" \"vitepress dev website\"",
        "website:build": "pnpm website:api && vitepress build website",
        "website:preview": "vitepress preview website",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "release:patch": "pnpm version patch && git push && git push --tags",
        "release:minor": "pnpm version minor && git push && git push --tags",
        "release:major": "pnpm version major && git push && git push --tags"
    },
    "keywords": [
        "tankerkoenig",
        "gas",
        "fuel",
        "prices",
        "germany",
        "api"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/creeperkatze/tankerkoenig-js"
    },
    "bugs": {
        "url": "https://github.com/creeperkatze/tankerkoenig-js/issues"
    },
    "author": "Creeperkatze",
    "license": "MIT",
    "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
    "engines": {
        "node": ">=18"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@lucide/vue": "^1.46.0",
        "@types/node": "^26.5.1",
        "@vitest/coverage-v8": "^3.2.7",
        "concurrently": "^10.0.5",
        "eslint": "^10.10.0",
        "globals": "^17.12.0",
        "typedoc": "^0.28.20",
        "typedoc-plugin-markdown": "^4.13.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vitepress": "^1.6.4",
        "vitest": "^3.2.7"
    }
}
