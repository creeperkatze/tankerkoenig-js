{
    "name": "tankerkoenig-js",
    "version": "1.0.18",
    "description": "JavaScript API client for the Tankerkönig gas prices API",
    "type": "module",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsc",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "release:patch": "pnpm version patch && git push && git push --tags",
        "release:minor": "pnpm version minor && git push && git push --tags",
        "release:major": "pnpm version major && git push && git push --tags"
    },
    "keywords": [
        "tankerkoenig",
        "gas",
        "fuel",
        "prices",
        "germany",
        "api"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/creeperkatze/tankerkoenig-js"
    },
    "bugs": {
        "url": "https://github.com/creeperkatze/tankerkoenig-js/issues"
    },
    "author": "Creeperkatze",
    "license": "MIT",
    "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
    "engines": {
        "node": ">=18"
    },
    "devDependencies": {
        "@types/node": "^25.9.6",
        "@vitest/coverage-v8": "^2.1.9",
        "typescript": "^5.9.3",
        "vitest": "^2.1.9"
    }
}
